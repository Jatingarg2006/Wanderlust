<style>
  .search-btn{
    background-color: #fe424d;
    color: #fff;
    border-radius: 25px;
    padding: 0 1rem 0 1rem;
  }
  .search-btn:hover{
    background-color: #fe424d;
    color: #fff;
  }
  .search-btn i{
    display: inline;
    margin-right: 0.5rem;
  }

  .search-inp {
    border-radius: 25px;
    padding: 0.5rem 3rem 0.5rem 3rem;
  }
</style>

<nav class="navbar navbar-expand-lg bg-body-tertiary">
  <div class="container-fluid">
    <a href="/listings"><i class="fa-solid fa-compass" style="font-size: 30px; color: red;"></i></a>
    
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    
    <!-- Unified collapse container -->
    <div class="collapse navbar-collapse" id="navbarNav">
      <!-- Left side links (me-auto pushes everything else to the right) -->
      <ul class="navbar-nav me-auto">
        <!-- <li class="nav-item">
          <a class="nav-link text-black" href="/listings">Home</a>
        </li> -->
        <li class="nav-item">
          <a class="nav-link text-black" href="/listings">Explore</a>
        </li>
        <li class="nav-item">
          <a class="nav-link text-black" href="/listings/new">Airbnb your home</a>
        </li>
      </ul>

      <div class="navbar-nav me-auto">
        <form class="d-flex" role="search">
          <input class="form-control me-2 search-inp" type="search" placeholder="Search destinations" />
          <button class="btn search-btn" type="submit"><i class="fa-solid fa-magnifying-glass"></i>Search</button>
        </form>
      </div>
      
      <!-- Right side links (Sign up, Log in, Log out) -->
      <ul class="navbar-nav">
        <% if(typeof currentUser === 'undefined' || !currentUser){ %> 
          <li class="nav-item">
            <a class="nav-link text-black" href="/signup"><b>Sign up</b></a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-black" href="/login"><b>Log in</b></a>
          </li>
        <% } else { %>
          <li class="nav-item">
            <a class="nav-link text-black" href="/logout"><b>Log out</b></a>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

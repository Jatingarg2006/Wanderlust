<% layout("layouts/boilerplate") -%> 
<body> 
  <div class="row mb-5 offset-2">
    <h2 class="mt-3">Create a New Listing</h2><br><br><br>

    <form class="col-10" method="post" action="/listings" enctype="multipart/form-data"> 
      
      <div class="mb-3"> 
        <label for="title" class="form-label fw-bold">Title</label> 
        <input name="title" type="text" class="form-control" required>
        <div class="valid-feedback">Correct!</div>
      </div> 

      <div class="mb-3"> 
        <label for="description" class="form-label fw-bold">Description</label> 
        <textarea name="description" class="form-control" required></textarea> 
      </div>

      <div class="mb-3"> 
        <label for="image" class="form-label fw-bold">Upload Listing Image</label> 
        <input name="listing[image]" type="file" class="form-control" required> 
      </div>
      
    <div class="mb-3"> 
        <label for="price" class="form-label fw-bold">Price</label> 
        <input name="price" type="text" class="form-control" required> 
    </div> 

    <div class="mb-3"> 
        <label for="country" class="form-label fw-bold">Country</label> 
        <input name="country" type="text" class="form-control" required> 
    </div>

    <div class="mb-3"> 
        <label for="location" class="form-label fw-bold">Location</label> 
        <input name="location" type="text" class="form-control" required> 
    </div> 

    <div>
        <button class="btn btn-dark px-4 add-btn">Add</button> 
    </div>
    </form> 
    
  </div>
</body>

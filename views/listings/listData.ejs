<% layout("layouts/boilerplate") -%>
<script src="/js/map.js"></script>
<% if(message && message.length>0){ %> 
    <div class="col-md-5 mx-auto mt-2"> 
        <div class="alert alert-secondary alert-dismissible fade show" role="alert" style="font-size: 0.9rem; padding-top: 0.5rem; padding-bottom: 0.5rem;"> 
            <span class="w-100 text-center d-block"><%= message %></span> 
        </div> 
    </div> 
<%}%>

<body>
  <!-- Container keeps everything centered on the screen -->
  <div class="container my-4">
    <div class="row justify-content-center">
      <div class="col-md-6">
        
        <h2 class="mb-3 text-center"><%= one.title %></h2>

        <!-- All details are now inside this single card -->
        <div class="card listing-card">
            <div class="ratio ratio-16x9 mb-4">
                <img src="<%= one.image.url %>" class="card-img-top" alt="<%= one.image.filename %>">
            </div>
          
          <div class="card-body">
            <p class="card-text">Owned by <i><%= one.owner.username %></i></p><br>
            <!-- Description -->
            <p class="card-text"><%= one.description %></p>
            
            <hr> <!-- Simple divider line -->

            <!-- Extra Details -->
            <p class="card-text">
              <strong>Price:</strong> &#8377; <%= one.price %><br>
              <strong>Location:</strong> <%= one.location %><br>
              <strong>Country:</strong> <%= one.country %>
            </p>

            <hr>

            <!-- Buttons placed side-by-side using a simple row -->
             <% if(currUser && currUser._id.equals(one.owner._id)){ %>

            <div class="row">
              <div class="col-6">
                <a href="/listings/<%= one._id %>/edit" class="btn btn-primary w-100"> Edit </a>
              </div>
              <div class="col-6">
                <form method="post" action="/listings/<%= one._id %>?_method=delete">
                  <button type="submit" class="btn btn-danger w-100"> Delete </button>
                </form>
              </div>
            </div>
            <hr>
            <% } %>
            
            <% if(currUser){ %>
            <div>
              <h4>Leave a Review</h4>
              <form action="/listings/<%= one._id %>/reviews" method="post">
                
                <div class="mb-3 mt-3"></div>
                <label for="rating" class="form-label form-range">Rating</label>
                  <fieldset class="starability-slot">
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                  </fieldset>
                </div>
                <div class="mb-3 mt-3">
                  <label for="comment" class="form-label">Comment</label>
                  <textarea name="review[comment]" id="comment" cols="30" row="10" class="form-control" required></textarea>
                </div>
                <button class="btn btn-outline-dark">Submit</button>
              </form>

              <hr>
              <%}%>
              
            <% if(one.reviews.length>0){ %>
            <div class="row">
              <b><p>All Reviews</p></b>
              <%for(review of one.reviews){%>
                  <div class="card col-5 mb-3 ms-3">
                    <div class="card-body">
                      <h5 class="card-title">@<%= review.author.username %></h5>
                      <p class="card-text"> <%= review.comment %> </p>
                      <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                    </div><br>
                    <form action="/listings/<%= one._id%>/reviews/<%= review._id %>?_method=DELETE" class="mb-3" method="post">
                      <button class="btn btn-sm btn-dark">Delete</button>
                    </form>
                  </div>
                <%}%>
              </div>
            </div>
          <% } %>

          </div>
        </div>

      </div>
    </div>
    <div class="col-8 offset-3 mb-3">
      <h3>Where you'll be</h3>
      <div id="map">

      </div>
      <script>
        let mapToken = "<%= process.env.MAP_TOKEN %>"
        let coordinates = <%- JSON.stringify(one.geometry.coordinates) %>;
        const map = new mapboxgl.Map({
        accessToken: mapToken,
        container: 'map', // container ID
        center: coordinates, // starting position [lng, lat]. Note that lat must be set between -90 and 90
        zoom: 9 // starting zoom
        });

        console.log(coordinates);

        const marker1 = new mapboxgl.Marker({color: "red"})
        .setLngLat(coordinates)
        .addTo(map);
      </script>
    </div>
  </div>
</body>

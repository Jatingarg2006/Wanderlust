<% layout("layouts/boilerplate") -%>
<% if(message && message.length>0){ %> 
    <div class="col-md-5 mx-auto mt-2"> 
        <div class="alert alert-secondary alert-dismissible fade show" role="alert" style="font-size: 0.9rem; padding-top: 0.5rem; padding-bottom: 0.5rem;"> 
            <span class="w-100 text-center d-block"><%= message %></span> 
        </div> 
    </div> 
<%}%>

<style>
    #filters {
        display: flex;
        flex-wrap: wrap;
        gap: 24px;       /* Adds uniform spacing between items */
        padding: 16px;
        margin-left: 60px;
        margin-bottom: 0.5rem;
        margin-top: 1rem;
    }

    .filter {
        display: flex;
        flex-direction: column; /* Stacks the icon above the text */
        align-items: center;    /* Centers items horizontally */
        text-align: center;
        min-width: 60px;       /* Ensures consistent layout sizing */
        cursor: pointer;
        opacity: 0.7;
    }

    .filter:hover{
        opacity: 1;
    }

    .filter i {
        font-size: 20px;
        margin-bottom: 6px;
        }
    .filter p {
        margin: 0;
        font-size: 12px;
    }

    .tax-info{
        display: none;
    }

    .tax-toggle{
        border: 1px solid black;
        border-radius: 1rem;
        height: 3.25rem;
        padding: 1rem;
        margin-left: 1rem;
        display: flex;
        align-items: center;
    }
</style>

<body>
    <!-- Centres the page heading -->
    <!-- <h3 class="text-center my-4">All Listings</h3> -->
    <div id="filters"> 
        <div class="filter"> 
            <div><i class="fa-solid fa-fire"></i></div> 
            <p>Trending</p> 
        </div> 

        <div class="filter"> 
            <div><i class="fa-solid fa-bed"></i></div> 
            <p>Rooms</p> 
        </div>
        
        <div class="filter"> 
            <div><i class="fa-solid fa-mountain-city"></i></div> 
            <p>Iconic Cities</p> 
        </div>

        <div class="filter"> 
            <div><i class="fa-solid fa-mountain"></i></div> 
            <p>Mountains</p> 
        </div>

        <div class="filter"> 
            <div><i class="fa-brands fa-fort-awesome"></i></div> 
            <p>Castles</p> 
        </div>

        <div class="filter"> 
            <div><i class="fa-solid fa-person-swimming"></i></div> 
            <p>Amazing Pools</p> 
        </div>

        <div class="filter"> 
            <div><i class="fa-solid fa-campground"></i></div> 
            <p>Camping</p> 
        </div>

        <div class="filter"> 
            <div><i class="fa-solid fa-cow"></i></div> 
            <p>Farms</p> 
        </div>

        <div class="filter"> 
            <div><i class="fa-solid fa-snowflake"></i></div> 
            <p>Arctic</p> 
        </div>

        <div class="filter"> 
            <div><i class="fa-solid fa-igloo"></i></div> 
            <p>Domes</p> 
        </div>

        <div class="filter"> 
            <div><i class="fa-solid fa-ship"></i></div> 
            <p>Houseboats</p> 
        </div>

        <div class="tax-toggle">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
                <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
            </div>
        </div>
    </div>

    <!-- justify-content-center centres the row grid columns on the screen -->
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 justify-content-center g-4 mx-auto" style="max-width: 1200px;">
        <% for(let list of allListings){ %>
            <a href="/listings/<%= list._id %>" class="listing-link text-dark text-decoration-none">
                <div class="col d-flex justify-content-center">
                <div class="card listing-card" style="width: 20rem;">
                    <img class="card-img-top" src="<%= list.image.url %>" alt="listing_image" style="height: 15rem; object-fit: cover;">
                    <div class="card-body text-center">
                        <p class="card-text"> 
                            <strong><%= list.title %></strong> <br>
                            ₹<%= list.price.toLocaleString("en-IN") %> / night
                            <i class="tax-info">+18% GST</i>
                        </p>
                    </div>
                </div>
            </div>
            </a>
        <% } %>
    </div>
</body>

<script>
    let taxSwitch = document.getElementById("flexSwitchCheckDefault");
    taxSwitch.addEventListener("click", () => {
        let taxInfo = document.getElementsByClassName("tax-info");
        for(info of taxInfo){
            if(info.style.display != "inline"){
                info.style.display = "inline";
            } else{
                info.style.display = "none";
            }
        }
    });
</script>